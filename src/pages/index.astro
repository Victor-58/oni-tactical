---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Sobre from '../components/Sobre.astro';
import Cursos from '../components/Cursos.astro';
import Treinamentos from '../components/Treinamentos.astro';
import Seguranca from '../components/Seguranca.astro';
import Instrutores from '../components/Instrutores.astro';
import Estrutura from '../components/Estrutura.astro';
import Depoimentos from '../components/Depoimentos.astro';
import Faq from '../components/Faq.astro';
import Contato from '../components/Contato.astro';
import WhatsappFloat from '../components/WhatsappFloat.astro';
import Footer from '../components/Footer.astro';
---

<Base
  titulo="ONI Tactical | Cursos e Treinamentos de Tiro Esportivo e Tático"
  descricao="ONI Tactical: cursos e treinamentos de tiro esportivo e treinamento tático em ambiente controlado, com instrutores qualificados, foco em segurança, técnica e cumprimento da legislação aplicável."
>
  <Header />
  <Hero />
  <Sobre />
  <Cursos />
  <Treinamentos />
  <Seguranca />
  <Instrutores />
  <Estrutura />
  <Depoimentos />
  <Faq />
  <Contato />
  <WhatsappFloat />
  <Footer />
</Base>
---
// src/layouts/Base.astro
import '../styles/global.css';
import '@fontsource/oswald/500.css';
import '@fontsource/oswald/600.css';
import '@fontsource/barlow/300.css';
import '@fontsource/barlow/400.css';
import '@fontsource/barlow/500.css';
import '@fontsource/ibm-plex-mono/400.css';

interface Props {
  titulo: string;
  descricao: string;
}

const { titulo, descricao } = Astro.props;
const tituloCompleto = titulo.includes('ONI Tactical')
  ? titulo
  : `${titulo} | ONI Tactical`;
---

<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

  <title>{tituloCompleto}</title>
  <meta name="description" content={descricao} />

  <meta property="og:title" content={tituloCompleto} />
  <meta property="og:description" content={descricao} />
  <meta property="og:type" content="website" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={tituloCompleto} />
  <meta name="twitter:description" content={descricao} />

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'LocalBusiness',
    name: 'ONI Tactical',
    description: 'Cursos e treinamentos de tiro esportivo e treinamento tático em ambiente controlado.',
    url: Astro.site?.toString(),
  })} />
</head>
<body>
  <slot />
</body>
</html>
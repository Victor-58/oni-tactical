---
// src/components/Instrutores.astro
import { getCollection } from 'astro:content';

const instrutoresData = await getCollection('instrutores');
const instrutores = instrutoresData.sort((a, b) => a.data.ordem - b.data.ordem);
---

<section id="instrutores" class="instrutores">
  <div class="inner">
    <span class="kicker">05 / Equipe</span>
    <h2>Instrutores</h2>

    <div class="instrutores-grid">
      {instrutores.map((item) => (
        <article class="instrutor-card">
          <div class="instrutor-foto">
            {item.data.foto ? (
              <img src={item.data.foto} alt={item.data.nome} />
            ) : (
              <span>[ foto do instrutor ]</span>
            )}
          </div>
          <div class="instrutor-body">
            <h3>{item.data.nome}</h3>
            <p class="instrutor-cargo">{item.data.cargo}</p>
            <dl>
              <div>
                <dt>Experiência</dt>
                <dd>{item.data.experiencia}</dd>
              </div>
              <div>
                <dt>Certificações</dt>
                <dd>{item.data.certificacoes}</dd>
              </div>
              <div>
                <dt>Especialidades</dt>
                <dd>{item.data.especialidades}</dd>
              </div>
            </dl>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .instrutores {
    scroll-margin-top: 78px;
    padding: 110px 24px;
    border-top: 1px solid #17181A;
  }

  .inner {
    max-width: 1280px;
    margin: 0 auto;
  }

  .kicker {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: #C8A24A;
  }

  h2 {
    font-family: 'Oswald', sans-serif;
    font-weight: 500;
    font-size: clamp(32px, 4.4vw, 52px);
    line-height: 1.04;
    text-transform: uppercase;
    margin: 20px 0 54px;
  }

  .instrutores-grid {
    display: grid;
    gap: 24px;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  }

  .instrutor-card {
    border: 1px solid #1E1F22;
    background: #0D0E10;
    border-radius: 20px;
    overflow: hidden;
  }

  .instrutor-foto {
    height: 330px;
    background: repeating-linear-gradient(135deg, #17181A 0 12px, #121315 12px 24px);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .instrutor-foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
  }

  .instrutor-foto span {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.16em;
    color: #55554F;
  }

  .instrutor-body {
    padding: 26px;
  }

  .instrutor-body h3 {
    font-family: 'Oswald', sans-serif;
    font-weight: 500;
    font-size: 21px;
    text-transform: uppercase;
    margin: 0 0 6px;
  }

  .instrutor-cargo {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #C8A24A;
    margin: 0 0 20px;
  }

  .instrutor-body dl {
    margin: 0;
    display: grid;
    gap: 14px;
  }

  .instrutor-body dt {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #6E6D68;
    margin-bottom: 5px;
  }

  .instrutor-body dd {
    margin: 0;
    font-size: 15px;
    color: #B8B7B2;
    font-weight: 300;
  }
</style>
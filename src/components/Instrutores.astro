---
// src/components/Instrutores.astro
import { getCollection } from 'astro:content';

const instrutoresData = await getCollection('instrutores');
const instrutores = instrutoresData.sort((a, b) => a.data.ordem - b.data.ordem);
---

<section id="instrutores" class="instrutores">
  <div class="inner">
    <span class="kicker">05 / Equipe</span>
    <h2>Instrutores</h2>
  </div>

  <div class="instrutores-carousel">
    <div class="swiper">
      <div class="swiper-wrapper">
        {instrutores.map((item) => (
          <div class="swiper-slide">
            <article class="instrutor-card">
              <div class="instrutor-foto">
                {item.data.foto ? (
                  <img src={item.data.foto} alt={item.data.nome} />
                ) : (
                  <span>[ foto do instrutor ]</span>
                )}
              </div>
              <div class="instrutor-body">
                <h3>{item.data.nome}</h3>
                <p class="instrutor-cargo">{item.data.cargo}</p>
                <dl>
                  <div>
                    <dt>Experiência</dt>
                    <dd>{item.data.experiencia}</dd>
                  </div>
                  <div>
                    <dt>Certificações</dt>
                    <dd>{item.data.certificacoes}</dd>
                  </div>
                  <div>
                    <dt>Especialidades</dt>
                    <dd>{item.data.especialidades}</dd>
                  </div>
                </dl>
              </div>
            </article>
          </div>
        ))}
      </div>
    </div>

    <div class="carousel-controls">
      <button type="button" class="carousel-arrow carousel-prev" aria-label="Instrutor anterior">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
      </button>
      <div class="swiper-pagination"></div>
      <button type="button" class="carousel-arrow carousel-next" aria-label="Próximo instrutor">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
      </button>
    </div>
  </div>
</section>

<style>
  .instrutores {
    scroll-margin-top: 78px;
    padding: 110px 0;
    border-top: 1px solid #17181A;
    overflow: hidden;
  }

  .inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .kicker {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: #C8A24A;
  }

  h2 {
    font-family: 'Oswald', sans-serif;
    font-weight: 500;
    font-size: clamp(32px, 4.4vw, 52px);
    line-height: 1.04;
    text-transform: uppercase;
    margin: 20px 0 54px;
  }

  .instrutores-carousel {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .swiper-slide {
    height: 520px;
  }

  .instrutor-card {
    height: 100%;
    box-sizing: border-box;
    border: 1px solid #1E1F22;
    background: #0D0E10;
    border-radius: 20px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .instrutor-foto {
    height: 300px;
    flex: 0 0 auto;
    background: repeating-linear-gradient(135deg, #17181A 0 12px, #121315 12px 24px);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .instrutor-foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
  }

  .instrutor-foto span {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.16em;
    color: #55554F;
  }

  .instrutor-body {
    padding: 26px;
    flex: 1;
    min-height: 0;
    overflow: hidden;
  }

  .instrutor-body h3 {
    font-family: 'Oswald', sans-serif;
    font-weight: 500;
    font-size: 21px;
    text-transform: uppercase;
    margin: 0 0 6px;
  }

  .instrutor-cargo {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #C8A24A;
    margin: 0 0 20px;
  }

  .instrutor-body dl {
    margin: 0;
    display: grid;
    gap: 14px;
  }

  .instrutor-body dt {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #8B8A85;
    margin-bottom: 5px;
  }

  .instrutor-body dd {
    margin: 0;
    font-size: 15px;
    color: #B8B7B2;
    font-weight: 300;
  }

  .carousel-controls {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 40px;
    padding: 0 60px;
  }

  .carousel-prev {
    position: absolute;
    left: 0;
  }

  .carousel-next {
    position: absolute;
    right: 0;
  }

  .carousel-arrow {
    flex-shrink: 0;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: transparent;
    border: 1px solid #35363A;
    color: #F2F1EE;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: border-color 0.3s, color 0.3s, background 0.3s;
  }

  .carousel-arrow:hover {
    border-color: #C8A24A;
    color: #C8A24A;
  }

  .instrutores-carousel :global(.swiper-pagination) {
    position: static !important;
    width: auto !important;
    left: auto !important;
    right: auto !important;
    bottom: auto !important;
    display: flex !important;
    justify-content: center;
    gap: 8px;
  }

  .instrutores-carousel :global(.swiper-pagination-bullet) {
    background: #35363A;
    opacity: 1;
    width: 8px;
    height: 8px;
  }

  .instrutores-carousel :global(.swiper-button-lock) {
    display: flex !important;
  }

  .instrutores-carousel :global(.swiper-pagination-bullet-active) {
    background: #C8A24A;
  }
</style>

<script>
  import Swiper from 'swiper';
  import { Navigation, Pagination } from 'swiper/modules';
  import 'swiper/css';
  import 'swiper/css/pagination';

  new Swiper('.instrutores-carousel .swiper', {
    modules: [Navigation, Pagination],
    slidesPerView: 1,
    spaceBetween: 20,
    rewind: true,
    speed: 700,
    pagination: {
      el: '.instrutores-carousel .swiper-pagination',
      clickable: true,
    },
    navigation: {
      prevEl: '.instrutores-carousel .carousel-prev',
      nextEl: '.instrutores-carousel .carousel-next',
    },
    breakpoints: {
      640: { slidesPerView: 2 },
      1024: { slidesPerView: 3 },
    },
  });
</script>
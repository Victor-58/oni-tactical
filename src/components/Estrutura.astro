---
// src/components/Estrutura.astro
const fotos = [
  "Área de treinamento",
  "Sala de aula",
  "Equipamentos de proteção",
  "Espaços de apoio",
  "Ambiente externo",
];
---

<section id="estrutura" class="estrutura">
  <div class="inner">
    <span class="kicker">06 / Instalações</span>
    <h2>Estrutura</h2>
    <p class="intro">
      As imagens abaixo serão substituídas por fotos reais das instalações
      utilizadas nos treinamentos.
    </p>
  </div>

  <div class="estrutura-carousel">
    <div class="swiper">
      <div class="swiper-wrapper">
        {
          fotos.map((label) => (
            <div class="swiper-slide">
              <button type="button" class="foto-btn" data-label={label}>
                <span>{label}</span>
              </button>
            </div>
          ))
        }
      </div>
      <div class="swiper-pagination"></div>
    </div>
  </div>
</section>

<div id="lightbox" class="lightbox" hidden>
  <button
    type="button"
    id="lightbox-close"
    class="lightbox-close"
    aria-label="Fechar">×</button
  >
  <div class="lightbox-content">
    <span id="lightbox-label"></span>
  </div>
</div>

<style>
  .estrutura {
    scroll-margin-top: 78px;
    padding: 110px 0;
    background: #0d0e10;
    border-top: 1px solid #17181a;
    overflow: hidden;
  }

  .inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .kicker {
    font-family: "IBM Plex Mono", monospace;
    font-size: 11px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: #c8a24a;
  }

  h2 {
    font-family: "Oswald", sans-serif;
    font-weight: 500;
    font-size: clamp(32px, 4.4vw, 52px);
    line-height: 1.04;
    text-transform: uppercase;
    margin: 20px 0 18px;
  }

  .intro {
    font-size: 16px;
    line-height: 1.7;
    color: #96958f;
    margin: 0 0 44px;
    max-width: 56ch;
    font-weight: 300;
  }

  .estrutura-carousel {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 24px 50px;
  }

  .swiper {
    width: 100%;
    padding-bottom: 10px;
  }

  .swiper-slide {
    height: 320px;
  }

  .foto-btn {
    all: unset;
    cursor: zoom-in;
    position: relative;
    width: 100%;
    height: 100%;
    background: repeating-linear-gradient(135deg, #17181A 0 12px, #121315 12px 24px);
    border: 1px solid #1E1F22;
    border-radius: 20px;
    overflow: hidden;
    display: flex;
  }

  .foto-btn:hover {
    border-color: #c8a24a;
  }

  .foto-btn span {
    padding: 18px;
    font-family: "IBM Plex Mono", monospace;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #9e9d97;
  }

  .estrutura-carousel :global(.swiper-pagination-bullet) {
    background: #35363a;
    opacity: 1;
    width: 8px;
    height: 8px;
  }

  .estrutura-carousel :global(.swiper-pagination-bullet-active) {
    background: #c8a24a;
  }

  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 200;
    background: rgba(6, 6, 7, 0.94);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
  }

  .lightbox[hidden] {
    display: none;
  }

  .lightbox-close {
    all: unset;
    position: absolute;
    top: 24px;
    right: 24px;
    cursor: pointer;
    font-size: 32px;
    color: #86857f;
    line-height: 1;
  }

  .lightbox-close:hover {
    color: #c8a24a;
  }

  .lightbox-content {
    width: 100%;
    max-width: 900px;
    height: 60vh;
    background: repeating-linear-gradient(135deg, #17181A 0 12px, #121315 12px 24px);
    border: 1px solid #1E1F22;
    border-radius: 10px;
    display: flex;
  }

  #lightbox-label {
    font-family: "IBM Plex Mono", monospace;
    font-size: 13px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #6e6d68;
  }
</style>

<script>
  import Swiper from "swiper";
  import { Autoplay, Pagination } from "swiper/modules";
  import "swiper/css";
  import "swiper/css/pagination";

  new Swiper(".swiper", {
    modules: [Autoplay, Pagination],
    slidesPerView: 1.15,
    spaceBetween: 16,
    loop: true,
    speed: 4000,
    autoplay: {
      delay: 1500,
      disableOnInteraction: false,
    },
    pagination: {
      el: ".swiper-pagination",
      clickable: true,
    },
        breakpoints: {
      640: { slidesPerView: 2 },
      1024: { slidesPerView: 2.6 },
    },
  });

  const buttons = document.querySelectorAll(".foto-btn");
  const lightbox = document.getElementById("lightbox");
  const lightboxLabel = document.getElementById("lightbox-label");
  const closeBtn = document.getElementById("lightbox-close");

  buttons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const label = btn.getAttribute("data-label") || "";
      if (lightboxLabel) lightboxLabel.textContent = `[ ${label} ]`;
      lightbox?.removeAttribute("hidden");
    });
  });

  closeBtn?.addEventListener("click", () => {
    lightbox?.setAttribute("hidden", "");
  });

  lightbox?.addEventListener("click", (e) => {
    if (e.target === lightbox) {
      lightbox.setAttribute("hidden", "");
    }
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      lightbox?.setAttribute("hidden", "");
    }
  });
</script>

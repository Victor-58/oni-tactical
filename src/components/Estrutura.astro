---
// src/components/Estrutura.astro
const fotos = [
  'Área de treinamento',
  'Sala de aula',
  'Equipamentos de proteção',
  'Espaços de apoio',
  'Ambiente externo',
];
---

<section id="estrutura" class="estrutura">
  <div class="inner">
    <span class="kicker">06 / Instalações</span>
    <h2>Estrutura</h2>
    <p class="intro">As imagens abaixo serão substituídas por fotos reais das instalações utilizadas nos treinamentos.</p>

    <div class="fotos-grid">
      {fotos.map((label) => (
        <button type="button" class="foto-btn" data-label={label}>
          <span>{label}</span>
        </button>
      ))}
    </div>
  </div>
</section>

<div id="lightbox" class="lightbox" hidden>
  <button type="button" id="lightbox-close" class="lightbox-close" aria-label="Fechar">×</button>
  <div class="lightbox-content">
    <span id="lightbox-label"></span>
  </div>
</div>

<style>
  .estrutura {
    scroll-margin-top: 78px;
    padding: 110px 24px;
    background: #0D0E10;
    border-top: 1px solid #17181A;
  }

  .inner {
    max-width: 1280px;
    margin: 0 auto;
  }

  .kicker {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: #C8A24A;
  }

  h2 {
    font-family: 'Oswald', sans-serif;
    font-weight: 500;
    font-size: clamp(32px, 4.4vw, 52px);
    line-height: 1.04;
    text-transform: uppercase;
    margin: 20px 0 18px;
  }

  .intro {
    font-size: 16px;
    line-height: 1.7;
    color: #96958F;
    margin: 0 0 44px;
    max-width: 56ch;
    font-weight: 300;
  }

  .fotos-grid {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  }

  .foto-btn {
    all: unset;
    cursor: zoom-in;
    position: relative;
    height: 260px;
    background: repeating-linear-gradient(135deg, #17181A 0 12px, #121315 12px 24px);
    border: 1px solid #1E1F22;
    display: flex;
    align-items: flex-end;
    transition: border-color 0.3s;
    box-sizing: border-box;
  }

  .foto-btn:hover {
    border-color: #C8A24A;
  }

  .foto-btn span {
    padding: 18px;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #9E9D97;
  }

  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 200;
    background: rgba(6, 6, 7, 0.94);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
  }

  .lightbox[hidden] {
    display: none;
  }

  .lightbox-close {
    all: unset;
    position: absolute;
    top: 24px;
    right: 24px;
    cursor: pointer;
    font-size: 32px;
    color: #86857F;
    line-height: 1;
  }

  .lightbox-close:hover {
    color: #C8A24A;
  }

  .lightbox-content {
    width: 100%;
    max-width: 900px;
    height: 60vh;
    background: repeating-linear-gradient(135deg, #17181A 0 12px, #121315 12px 24px);
    border: 1px solid #1E1F22;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #lightbox-label {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 13px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #6E6D68;
  }
</style>

<script>
  const buttons = document.querySelectorAll('.foto-btn');
  const lightbox = document.getElementById('lightbox');
  const lightboxLabel = document.getElementById('lightbox-label');
  const closeBtn = document.getElementById('lightbox-close');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const label = btn.getAttribute('data-label') || '';
      if (lightboxLabel) lightboxLabel.textContent = `[ ${label} ]`;
      lightbox?.removeAttribute('hidden');
    });
  });

  closeBtn?.addEventListener('click', () => {
    lightbox?.setAttribute('hidden', '');
  });

  // Fecha clicando fora do conteúdo (no fundo escuro)
  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) {
      lightbox.setAttribute('hidden', '');
    }
  });

  // Fecha com a tecla Esc
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      lightbox?.setAttribute('hidden', '');
    }
  });
</script>
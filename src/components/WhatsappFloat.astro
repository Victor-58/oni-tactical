---
// src/components/WhatsappFloat.astro
const numero = '5598991304638';
const mensagem = 'Olá! Vim pelo site da ONI Tactical e gostaria de mais informações.';
const link = `https://wa.me/${numero}?text=${encodeURIComponent(mensagem)}`;
---

<a href={link} target="_blank" rel="noopener noreferrer" class="whatsapp-float" aria-label="Falar no WhatsApp">
  <svg viewBox="0 0 32 32" width="28" height="28" fill="currentColor" aria-hidden="true">
    <path d="M16.004 3C9.373 3 4 8.373 4 15.004c0 2.65.86 5.1 2.32 7.09L4.6 28.4l6.47-1.7a11.94 11.94 0 0 0 4.93 1.06h.005C22.63 27.76 28 22.39 28 15.76 28 9.13 22.63 3.76 16.004 3Zm0 21.86h-.004a9.9 9.9 0 0 1-5.05-1.38l-.36-.21-3.84 1.01 1.03-3.74-.24-.38a9.86 9.86 0 0 1-1.52-5.16c0-5.46 4.45-9.9 9.92-9.9 2.65 0 5.14 1.03 7.01 2.9a9.83 9.83 0 0 1 2.9 6.99c0 5.46-4.45 9.87-9.86 9.87Zm5.42-7.4c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.65.07-.3-.15-1.25-.46-2.38-1.47-.88-.78-1.47-1.75-1.65-2.05-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.87 1.22 3.07c.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.62.71.23 1.36.2 1.87.12.57-.08 1.75-.71 2-1.4.25-.69.25-1.28.17-1.4-.07-.13-.27-.2-.57-.35Z"/>
  </svg>
</a>

<style>
  .whatsapp-float {
    position: fixed;
    bottom: 80px;
    right: 24px;
    z-index: 150;
    width: 58px;
    height: 58px;
    border-radius: 50%;
    background: #25D366;
    color: #0A0A0B;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.4);
    transition: transform 0.25s, background 0.25s;
  }

  .whatsapp-float:hover {
    background: #2FE377;
    transform: scale(1.08);
  }

  @media (max-width: 480px) {
    .whatsapp-float {
      bottom: 70px;
      right: 18px;
      width: 52px;
      height: 52px;
    }
  }
</style>
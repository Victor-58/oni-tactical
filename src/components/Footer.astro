---
// src/components/Footer.astro
const anoAtual = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer-inner">
    <div class="footer-grid">
      <div>
        <div class="footer-logo">
          <img src="/imagens/oni-logo.png" alt="ONI Tactical" />
        </div>
        <p class="footer-tagline">Treinamento, técnica e precisão.</p>
        <p class="footer-desc">
          A ONI Tactical atua com foco em treinamento responsável, segurança e cumprimento da legislação aplicável.
        </p>
      </div>

      <nav class="footer-nav">
        <span class="footer-label">Navegação</span>
        <a href="#top">Início</a>
        <a href="#sobre">Sobre</a>
        <a href="#cursos">Cursos</a>
        <a href="#instrutores">Instrutores</a>
        <a href="#estrutura">Estrutura</a>
        <a href="#faq">FAQ</a>
        <a href="#contato">Contato</a>
      </nav>

      <div class="footer-contact">
        <span class="footer-label">Contato</span>
        <a href="#">Instagram @onitactical</a>
        <a href="#">WhatsApp (00) 00000-0000</a>
        <a href="#">contato@exemplo.com</a>
        <span class="footer-address">Endereço a informar</span>
      </div>

      <div class="footer-admin">
        <span class="footer-label">Administração</span>
        <a href="/admin" class="footer-admin-btn">Painel administrativo</a>
      </div>
    </div>

    <div class="footer-bottom">
      <span>© {anoAtual} ONI Tactical. Todos os direitos reservados.</span>
      <span>Conteúdo institucional e educacional.</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid #17181A;
    background: #0D0E10;
    padding: 76px 24px 34px;
  }

  .footer-inner {
    max-width: 1280px;
    margin: 0 auto;
  }

  .footer-grid {
    display: grid;
    gap: 48px;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    padding-bottom: 48px;
    border-bottom: 1px solid #1E1F22;
  }

  .footer-logo {
    width: 88px;
    height: 65px;
    position: relative;
    overflow: hidden;
    margin-bottom: 20px;
  }

  .footer-logo img {
    position: absolute;
    width: 124px;
    height: 124px;
    left: -19px;
    top: -32px;
    mix-blend-mode: screen;
  }

  .footer-tagline {
    font-family: 'Oswald', sans-serif;
    font-size: 15px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #A5A49E;
    margin: 0 0 20px;
  }

  .footer-desc {
    font-size: 14px;
    line-height: 1.7;
    color: #7E7D78;
    margin: 0;
    max-width: 34ch;
    font-weight: 300;
  }

  .footer-nav,
  .footer-contact,
  .footer-admin {
    display: flex;
    flex-direction: column;
    gap: 11px;
  }

  .footer-admin {
    align-items: flex-start;
  }

  .footer-label {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #6E6D68;
    margin-bottom: 6px;
  }

  .footer-nav a,
  .footer-contact a {
    font-size: 15px;
    color: #C0BFBA;
    transition: color 0.3s;
  }

  .footer-nav a:hover,
  .footer-contact a:hover {
    color: #C8A24A;
  }

  .footer-address {
    font-size: 15px;
    color: #7E7D78;
    font-weight: 300;
  }

  .footer-admin-btn {
    background: transparent;
    border: 1px solid #26272B;
    color: #C0BFBA;
    padding: 13px 20px;
    font-family: 'Oswald', sans-serif;
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
    transition: border-color 0.3s, color 0.3s;
  }

  .footer-admin-btn:hover {
    border-color: #C8A24A;
    color: #C8A24A;
  }

  .footer-bottom {
    padding-top: 28px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: space-between;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    color: #6E6D68;
  }
</style>
---
// src/components/Cursos.astro
import { getCollection } from 'astro:content';

const cursosData = await getCollection('cursos', ({ data }) => data.publicado);
const cursos = cursosData.sort((a, b) => a.data.ordem - b.data.ordem);
---

<section id="cursos" class="cursos">
  <div class="inner">
    <div class="cursos-header">
      <div>
        <span class="kicker">02 / Programas</span>
        <h2>Cursos e Treinamentos</h2>
      </div>
      <p class="cursos-intro">Trilha progressiva, do primeiro contato com a prática esportiva ao aperfeiçoamento técnico avançado.</p>
    </div>
  </div>

  <div class="cursos-carousel">
    <div class="swiper">
      <div class="swiper-wrapper">
        {cursos.map((curso) => (
          <div class="swiper-slide">
            <article class="curso-card">
              <div class="curso-imagem">
                <span>[ imagem do curso ]</span>
              </div>
              <div class="curso-body">
                <h3>{curso.data.nome}</h3>
                <p class="curso-desc">{curso.data.descricao}</p>
                <dl class="curso-meta">
                  <dt>Nível</dt><dd>{curso.data.nivel}</dd>
                  <dt>Duração</dt><dd>{curso.data.duracao}</dd>
                  <dt>Modalidade</dt><dd>{curso.data.modalidade}</dd>
                </dl>
                <a href={`/cursos/${curso.id}`} class="curso-btn">Ver detalhes</a>
              </div>
            </article>
          </div>
        ))}
      </div>
    </div>

        <div class="carousel-controls">
      <button type="button" class="carousel-arrow carousel-prev" aria-label="Curso anterior">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
      </button>
      <div class="swiper-pagination"></div>
      <button type="button" class="carousel-arrow carousel-next" aria-label="Próximo curso">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
      </button>
    </div>
  </div>
</section>

<style>
  .cursos {
    scroll-margin-top: 78px;
    padding: 110px 0;
    background: #0D0E10;
    border-top: 1px solid #17181A;
    overflow: hidden;
  }

  .inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .cursos-header {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 54px;
  }

  .kicker {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: #C8A24A;
  }

  h2 {
    font-family: 'Oswald', sans-serif;
    font-weight: 500;
    font-size: clamp(32px, 4.4vw, 52px);
    line-height: 1.04;
    text-transform: uppercase;
    margin: 20px 0 0;
  }

  .cursos-intro {
    max-width: 42ch;
    font-size: 16px;
    line-height: 1.7;
    color: #96958F;
    margin: 0;
    font-weight: 300;
  }

  .cursos-carousel {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .swiper-slide {
    height: 480px;
  }

  .curso-card {
    height: 100%;
    box-sizing: border-box;
    border: 1px solid #1E1F22;
    background: #0A0A0B;
    display: flex;
    flex-direction: column;
    transition: border-color 0.3s, transform 0.3s;
    border-radius: 20px;
    overflow: hidden;
  }

  .curso-card:hover {
    border-color: #C8A24A;
    transform: translateY(-4px);
  }

  .curso-imagem {
    height: 190px;
    flex: 0 0 auto;
    background: repeating-linear-gradient(135deg, #17181A 0 12px, #121315 12px 24px);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .curso-imagem span {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.16em;
    color: #55554F;
  }

  .curso-body {
    padding: 26px;
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
  }

  .curso-body h3 {
    font-family: 'Oswald', sans-serif;
    font-weight: 500;
    font-size: 22px;
    line-height: 1.2;
    text-transform: uppercase;
    margin: 0 0 12px;
  }

  .curso-meta {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 8px 16px;
    margin: 0 0 24px;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
  }

  .curso-meta dt {
    color: #6E6D68;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .curso-meta dd {
    margin: 0;
    color: #DAD9D4;
  }

  .curso-btn {
    margin-top: auto;
    align-self: flex-start;
    background: transparent;
    border: 1px solid #35363A;
    color: #F2F1EE;
    padding: 13px 24px;
    font-family: 'Oswald', sans-serif;
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    cursor: pointer;
    transition: border-color 0.3s, color 0.3s;
    border-radius: 10px;
  }

  .curso-btn:hover {
    border-color: #C8A24A;
    color: #C8A24A;
  }

  .carousel-controls {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 40px;
    padding: 0 60px;
  }

  .carousel-prev {
    position: absolute;
    left: 0;
  }

  .carousel-next {
    position: absolute;
    right: 0;
  }

  .carousel-arrow {
    flex-shrink: 0;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: transparent;
    border: 1px solid #35363A;
    color: #F2F1EE;
    font-size: 22px;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: border-color 0.3s, color 0.3s, background 0.3s;
  }

  .carousel-arrow:hover {
    border-color: #C8A24A;
    color: #C8A24A;
  }

  .carousel-controls :global(.swiper-pagination-bullet) {
    background: #35363A;
    opacity: 1;
    width: 8px;
    height: 8px;
  }

  .carousel-controls :global(.swiper-pagination-bullet-active) {
    background: #C8A24A;
  }

  .carousel-controls :global(.swiper-pagination) {
    position: static !important;
    width: auto !important;
    left: auto !important;
    right: auto !important;
    bottom: auto !important;
    display: flex !important;
    gap: 8px !important;
  }

    .curso-desc {
    font-size: 15px;
    line-height: 1.65;
    color: #A5A49E;
    margin: 0 0 22px;
    font-weight: 300;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
  }
</style>

<script>
  import Swiper from 'swiper';
  import { Navigation, Pagination } from 'swiper/modules';
  import 'swiper/css';
  import 'swiper/css/pagination';

  new Swiper('.cursos-carousel .swiper', {
    modules: [Navigation, Pagination],
    slidesPerView: 1,
    spaceBetween: 20,
    rewind: true,
    speed: 700,
    pagination: {
      el: '.cursos-carousel .swiper-pagination',
      clickable: true,
    },
    navigation: {
      prevEl: '.cursos-carousel .carousel-prev',
      nextEl: '.cursos-carousel .carousel-next',
    },
    breakpoints: {
      640: { slidesPerView: 2 },
      1024: { slidesPerView: 3 },
    },
  });
</script>